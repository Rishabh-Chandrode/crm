# Database
POSTGRES_DB=crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend
ADMIN_PASSWORD=change-me-before-use

# Gmail (preferred — sends from your real Gmail address, no domain needed)
# Setup: Google Account → Security → 2-Step Verification → App Passwords → Mail
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
FROM_NAME=Your Name

# Resend (fallback — only used when GMAIL_USER / GMAIL_APP_PASSWORD are not set)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=you@yourdomain.com
REPLY_TO_EMAIL=you@gmail.com

PORT=3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
