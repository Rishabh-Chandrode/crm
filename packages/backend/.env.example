# Database (Local Postgres or Neon Serverless Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm
POSTGRES_DB=crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Server & Auth
PORT=3001
ADMIN_PASSWORD=change-me-before-use
JWT_SECRET=change-me-in-production
TRACKING_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Gmail OAuth2 & Google Login
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/gmail/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Resend (Optional fallback email provider)
RESEND_API_KEY=
FROM_EMAIL=
FROM_NAME=CRM
REPLY_TO_EMAIL=

# Enrichment Providers (Apollo / Prospeo)
APOLLO_API_KEY=
PROSPEO_API_KEY=
ACTIVE_ENRICHMENT_PROVIDER=prospeo

# Supabase Storage (Optional cloud document storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=documents
