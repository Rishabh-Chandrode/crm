{
  "manifest_version": 3,
  "name": "Outreach CRM",
  "version": "1.0.0",
  "description": "Add LinkedIn prospects to your Outreach CRM",
  "permissions": ["cookies", "activeTab", "tabs", "storage", "scripting", "clipboardRead", "sidePanel"],
  "action": {
    "default_icon": "image.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "host_permissions": ["http://localhost:*/*", "https://localhost:*/*", "https://www.linkedin.com/*", "https://crm-frontend-black-three.vercel.app/*", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["dist/contentScript.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3002/*",
        "https://crm-frontend-black-three.vercel.app/*"
      ],
      "js": ["dist/authCapture.js"],
      "run_at": "document_idle"
    }
  ]
}